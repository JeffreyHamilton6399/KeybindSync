{
  "schemaVersion": 1,
  "id": "keybindsync",
  "version": "${version}",
  "name": "KeybindSync",
  "description": "Save and load named keybind profiles (pvp, survival…) without restarting. Press F8 to save, F9 to load.",
  "authors": [
    "jeffreyscotthamilton6399"
  ],
  "contact": {
    "sources": "https://github.com/jeffreyscotthamilton6399/KeybindSync",
    "issues": "https://github.com/jeffreyscotthamilton6399/KeybindSync/issues"
  },
  "license": "MIT",
  "icon": "assets/keybindsync/textures/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.keybindsync.KeybindSyncMod"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.20 <=1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
